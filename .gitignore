# ---- Data (never commit the raw dataset or large/intermediate data) ----
data/raw/
data/**/*.parquet
data/**/*.csv
!data/README.md

# ---- Secrets / env ----
.env
.env.*
!.env.example

# ---- Python ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- ML generated outputs are tracked selectively ----
# (artifacts JSON + model are committed small; keep large binaries out)
*.pkl
ml/artifacts/**/*.png.tmp

# ---- Node / Angular ----
node_modules/
frontend/dist/
frontend/.angular/
.angular/
npm-debug.log*

# ---- Editor / OS ----
.DS_Store
Thumbs.db
*.swp
.idea/

# ---- Build info generated by CD ----
frontend/src/environments/build-info.ts

# ---- Misc large files guard ----
*.zip
*.7z

# ---- Reference paper PDF (copyrighted; keep local, do not publish) ----
TSP_CMC_77139.pdf
*.pdf
